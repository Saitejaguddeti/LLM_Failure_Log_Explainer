# Copy to .env and fill in. Without LLM_MODEL the tool still works, using only its built-in failure patterns.

# Chat model as provider:model. Install the matching extra: pip install -e ".[anthropic]" (or openai / bedrock)
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_MODEL=openai:<model name>        and OPENAI_API_KEY=
# LLM_MODEL=bedrock_converse:<model id> and the usual AWS credentials / AWS_REGION

# Where Airflow keeps task logs (only needed for the failure callback, if not the default)
# AIRFLOW__LOGGING__BASE_LOG_FOLDER=/opt/airflow/logs
